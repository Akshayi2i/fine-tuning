{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - motorcycle (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for motorcycle (code MC), composing common_model.json 1.0.0 by $ref: the envelope plus locations (garaging), vehicles, drivers and rating_modifiers. Built from all 9 motorcycle seed golds of 3 carriers and the line's registry YAMLs. No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "motorcycle",
  "fideon:lob_code": "MC",
  "fideon:layout_family": "personal_lines",
  "fideon:schema_version": "1.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema, built from 9 seed golds of 3 carriers; field list awaiting project-owner approval",
  "fideon:built_from": {
    "seed_golds": 9,
    "carriers": [
      "All State",
      "Progressive",
      "RT Specialty"
    ],
    "registry_yamls": [
      "motorcycle"
    ]
  },
  "fideon:blocks_used": [
    "locations",
    "vehicles",
    "drivers",
    "rating_modifiers"
  ],
  "fideon:lob_block": "None. Every concept the seeds print has a home in the envelope or a common-model building block (SPEC_21 4.2.4).",
  "fideon:coverage_codes_file": "motorcycle.coverage_codes.yaml",
  "fideon:coverage_codes": [
    "MC_ACCESSORIES",
    "MC_GUEST_LIABILITY",
    "MC_OPTIONAL_BASIC_ECONOMIC_LOSS",
    "MC_PASSENGER_LIABILITY",
    "MC_PEDESTRIAN_PIP",
    "MC_SAFETY_CLOTHING_TOWING",
    "MC_SUPPLEMENTAL_SPOUSAL_LIABILITY",
    "MC_WRONGFUL_DEATH",
    "X_COLLISION",
    "X_COMPREHENSIVE",
    "X_MED_PAY",
    "X_PIP",
    "X_TOWING",
    "X_UIM",
    "X_UM",
    "X_VEHICLE_LIABILITY"
  ],
  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[].limits[].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1",
    "premium.minimum <= premium.total",
    "premium.total == sum(premium.items[unit_type=coverage].amount) + sum(coverages[].premium) ± 1"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules without the claims-made rule; four seeds print the term.",
  "fideon:aliases": {
