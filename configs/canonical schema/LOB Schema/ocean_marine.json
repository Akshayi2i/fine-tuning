{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - ocean_marine (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for ocean_marine (code OM; the personal boat / watercraft line), composing common_model.json 1.0.0 by $ref: the envelope plus watercraft, drivers (operators) and rating_modifiers. Built from all 4 boat seed golds of 3 carriers and the ocean_marine and watercraft registry YAMLs. No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "ocean_marine",
  "fideon:lob_code": "OM",
  "fideon:layout_family": "personal_lines",
  "fideon:schema_version": "1.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema, built from 4 seed golds of 3 carriers; field list awaiting project-owner approval",
  "fideon:built_from": {
    "seed_golds": 4,
    "carriers": [
      "Markel American Insurance Company",
      "Progressive",
      "Travelers"
    ],
    "registry_yamls": [
      "ocean_marine",
      "watercraft"
    ]
  },
  "fideon:blocks_used": [
    "watercraft",
    "drivers",
    "rating_modifiers"
  ],
  "fideon:lob_block": "None. Every concept the seeds print has a home in the envelope or a common-model building block (SPEC_21 4.2.4).",
  "fideon:coverage_codes_file": "ocean_marine.coverage_codes.yaml",
  "fideon:coverage_codes": [
    "OM_AGREED_VALUE_HULL",
    "OM_AGREED_VALUE_MACHINERY",
    "OM_COASTAL_NAVIGATION",
    "OM_DISAPPEARING_DEDUCTIBLE",
    "OM_DRIVE_SYSTEM_PROTECTION",
    "OM_FUEL_SPILL_LIABILITY",
    "OM_HAUL_OUT_EXPENSE",
    "OM_MARINE_ELECTRONICS",
    "OM_NEW_BOAT_REPLACEMENT",
    "OM_ON_WATER_TOWING",
    "OM_PERSONAL_PROPERTY",
    "OM_PROPULSION_PLUS",
    "OM_REPLACEMENT_COST_PERSONAL_EFFECTS",
    "OM_TRAILER",
    "OM_WATERCRAFT_EQUIPMENT",
    "OM_WRECKAGE_REMOVAL",
    "X_COLLISION",
    "X_COMPREHENSIVE",
    "X_MED_PAY",
    "X_TOWING",
    "X_UM",
    "X_VEHICLE_LIABILITY"
  ],
  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[].limits[].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1",
    "premium.total == sum(coverages[].premium) ± 1"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules without the claims-made rule; two seeds print the term.",
