{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - personal_umbrella (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for personal_umbrella (code PU), composing common_model.json 1.0.0 by $ref: the envelope plus underlying_insurance. Built from all 4 personal umbrella seed golds of 2 carriers and the line's registry YAMLs. No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "personal_umbrella",
  "fideon:lob_code": "PU",
  "fideon:layout_family": "personal_lines",
  "fideon:schema_version": "1.0.0",
  "fideon:common_model_version": "1.0.0",
  "fideon:status": "SPEC_21 Phase 2 schema, built from 4 seed golds of 2 carriers; field list awaiting project-owner approval",
  "fideon:built_from": {
    "seed_golds": 4,
    "carriers": [
      "NYCM Insurance",
      "Plymouth"
    ],
    "registry_yamls": [
      "personal_umbrella"
    ]
  },
  "fideon:blocks_used": [
    "underlying_insurance"
  ],
  "fideon:lob_block": "None. Every concept the seeds print has a home in the envelope or a common-model building block (SPEC_21 4.2.4).",
  "fideon:coverage_codes_file": "personal_umbrella.coverage_codes.yaml",
  "fideon:coverage_codes": [
    "PU_EXCESS_UM_UIM",
    "PU_INCIDENTAL_OCCUPANCY",
    "PU_LIABILITY"
  ],
  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[coverage_code=PU_LIABILITY].limits[limit_type=per_occurrence].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1",
    "premium.total == sum(coverages[].premium) ± 1",
    "len(underlying_insurance[]) >= 1",
    "`coverages[coverage_code=PU_LIABILITY].deductibles[deductible_type=retention].amount` <= `coverages[coverage_code=PU_LIABILITY].limits[limit_type=per_occurrence].amount`"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules without the claims-made rule; NYCM prints the term.",
  "fideon:aliases": {
    "carrier.claims_phone": [
      "To Report a Claim"
    ],
    "carrier.name": [
      "Insurance Provided By",
      "Policy Issued by"
    ],
    "coverages[].deductibles[].amount": [
      "Deductible"
    ],
    "document.issue_date": [
      "Issue Date"
    ],
    "document.transaction_effective_date": [
      "Transaction Effective"
    ],
    "document.transaction_reason": [
      "Transaction Reason",
      "Transaction Reason Description"
    ],
    "document.transaction_type": [
      "Transaction Type"
    ],
    "named_insured.primary_name": [
      "Named Insured",
      "Named Insured and Address"
    ],
    "policy.effective_date": [
      "Effective Date",
      "Policy Effective Date"
    ],
    "policy.expiration_date": [
      "Expiration Date"
    ],
    "policy.original_inception_date": [
      "Inception Date",
      "Protected Since Date"
    ],
    "policy.policy_number": [
      "Policy Number"
    ],
    "policy.term_months": [
      "Term Length"
    ],
    "premium.change": [
      "Total return premium"
    ],
    "premium.total": [
      "TOTAL PREMIUM",
      "Total Policy Premium"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "carrier",
    "named_insured",
    "policy",
    "lob_parts",
    "coverages"
  ],
  "properties": {
    "document": {
      "$ref": "../common/common_model.json#/$defs/document"
    },
    "carrier": {
      "$ref": "../common/common_model.json#/$defs/carrier"
    },
    "producer": {
      "$ref": "../common/common_model.json#/$defs/producer"
    },
    "named_insured": {
      "$ref": "../common/common_model.json#/$defs/named_insured"
    },
    "policy": {
      "$ref": "../common/common_model.json#/$defs/policy"
    },
    "lob_parts": {
      "$ref": "../common/common_model.json#/$defs/lob_parts"
    },
    "coverages": {
      "$ref": "../common/common_model.json#/$defs/coverages"
    },
    "deductibles": {
      "$ref": "../common/common_model.json#/$defs/deductibles"
    },
    "interested_parties": {
      "$ref": "../common/common_model.json#/$defs/interested_parties"
    },
    "premium": {
      "$ref": "../common/common_model.json#/$defs/premium"
    },
    "billing": {
      "$ref": "../common/common_model.json#/$defs/billing"
    },
    "forms_and_endorsements": {
      "$ref": "../common/common_model.json#/$defs/forms_and_endorsements"
    },
    "underlying_insurance": {
      "$ref": "../common/common_model.json#/$defs/underlying_insurance"
    },
    "additional_fields": {
      "$ref": "../common/common_model.json#/$defs/additional_fields"
    },
    "text_sections": {
      "$ref": "../common/common_model.json#/$defs/text_sections"
    },
    "fideon:provenance": {
      "$ref": "../common/common_model.json#/$defs/provenance"
    }
  }
}
