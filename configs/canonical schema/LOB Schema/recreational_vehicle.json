  "title": "Fideon canonical schema - recreational_vehicle (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for recreational_vehicle (code RV), composing common_model.json 1.0.0 by $ref: the envelope plus locations (garaging), vehicles (motor homes, trailers, snowmobiles, off-road), drivers and rating_modifiers. Built from all 22 RV seed golds of 4 carriers and the line's registry YAMLs. No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "recreational_vehicle",
  "fideon:lob_code": "RV",
  "fideon:layout_family": "personal_lines",
  "fideon:schema_version": "1.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema, built from 22 seed golds of 4 carriers; field list awaiting project-owner approval",
  "fideon:built_from": {
    "seed_golds": 22,
    "carriers": [
      "All State",
      "American Modern",
      "Foremost Insurance Company",
      "Progressive"
    ],
    "registry_yamls": [
      "recreational_vehicle"
    ]
  },
  "fideon:blocks_used": [
    "locations",
    "vehicles",
    "drivers",
    "rating_modifiers"
  ],
  "fideon:lob_block": "None. Every concept the seeds print has a home in the envelope or a common-model building block (SPEC_21 4.2.4).",
