# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Secrets come from the environment only - never from YAML in configs/.

# ---------------------------------------------------------------------------
# Azure Blob - all artifacts: raw PDFs, corpora, adapters, models, registries
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
AZURE_BLOB_CONTAINER=insurance-extraction

# raw-documents/ is the ONLY layer holding unredacted PII, so it gets its own
# container with tighter RBAC - fewer identities with read access than the
# corpus and adapter layers that training jobs need (arch 18a).
AZURE_RAW_CONTAINER=insurance-extraction-raw

# ---------------------------------------------------------------------------
# RunPod - ephemeral training pods + a persistent serverless endpoint
# ---------------------------------------------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Network volume holding adapters and the merged model BETWEEN command 1
# (finetune) and command 2 (package). Working storage with no durability
# guarantee - not the registry (master 12a). The merged model is ~16GB and
# quantization also runs on RunPod, so staging avoids a 32GB round trip.
RUNPOD_VOLUME_ID=
RUNPOD_VOLUME_MOUNT=/runpod-volume

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------
HF_TOKEN=
# Pin the revision. Also set configs/base_model.yaml model.revision to match -
# a floating revision makes a regression impossible to attribute.
HF_MODEL_REVISION=

# ---------------------------------------------------------------------------
# Experiment tracking (optional - the Blob run manifest is the durable record;
# these only add a queryable UI over it)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=
WANDB_API_KEY=

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# Single-tenant build: the tenant_id path prefix is reserved so no migration is
# needed later, but it is not a required CLI argument. The live rule is that a
# corpus file must never mix tenants, because corpus composition is training
# data (arch 8b).
DEFAULT_TENANT_ID=default

# ---------------------------------------------------------------------------
# Labeling guards
# ---------------------------------------------------------------------------
# Sending PII to a third-party model API may violate compliance or the DPA.
# The external pre-annotation backend REFUSES to run unless this is true AND
# --allow-external is passed (arch 7).
ALLOW_EXTERNAL_PREANNOTATION=false
# The second half of that guard: a zero-retention / enterprise endpoint. A
# default consumer endpoint may retain prompts, which is the thing the guard
# exists to prevent, so the backend refuses without this too.
EXTERNAL_PREANNOTATION_ENDPOINT=

# ---------------------------------------------------------------------------
# Base model and training host
# ---------------------------------------------------------------------------
# Where the pod keeps the base weights. Overrides model.local_dir in
# configs/base_model.yaml (default /workspace/models). Training, the tokenizer,
# the merge and vLLM all load the base from here, never from the Hub.
FIDEON_BASE_MODEL_DIR=
# Set to 1 to launch training on a GPU host that is not the RunPod pod. A real
# launch is otherwise refused without CUDA, the staging volume and the base.
FIDEON_ALLOW_OFF_POD=
